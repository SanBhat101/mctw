# Frontend dev settings. Copy to frontend/.env and adjust. frontend/.env is git-ignored.
# Only variables prefixed with VITE_ ever reach browser code; API_URL does not.

# FastAPI backend that `npm run dev` / `npm run preview` proxy /api requests to.
API_URL=http://127.0.0.1:8000

# Backend URL the built app calls directly (baked in at `npm run build`; public).
# Leave empty to use same-origin /api via the proxy above or your own reverse proxy.
# If set, also add this frontend's origin to CORS_ORIGINS in backend/.env.
VITE_API_BASE_URL=
